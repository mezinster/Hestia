    <!-- Écran À propos (lot 7) -->
    <string name="about_version">Version %1$s</string>
    <string name="about_name_origin_title">Origin of the name</string>
    <string name="about_name_origin">In Greek mythology, Hestia is the goddess of the hearth and domestic fire. She watches over the home, quietly.</string>
    <string name="about_positioning_title">Local control by default</string>
    <string name="about_positioning">Hestia controls your devices entirely on the local network, with no cloud and no account, by default. Two separate options exist, both off by default and opt-in: instant notifications via ntfy (Settings), which send the text of your notifications to an external service of your choice; and connecting a device to Shelly Cloud (Edit screen), which lets you keep control from a mobile network away from home.</string>
    <string name="about_positioning_network">On local Wi-Fi: every feature works. On mobile data (cloud fallback, if enabled): only state, power use and on/off for a plug, state (alarm, battery) for a smoke detector — everything else (schedules, presence simulation, button timer, threshold cutoff, LED, firmware update, muting the alarm) requires being on the same Wi-Fi network as the device.</string>
    <string name="about_permission_title">Local network permission</string>
    <string name="about_permission_body">Since Android 17, an app must ask your permission to talk to devices on your local network. Hestia needs it to talk to your devices. It only contacts the addresses you\'ve entered yourself, never scans your network, and never sends anything outside it.</string>
    <string name="about_independence_title">Independence</string>
    <string name="about_independence">Hestia is an independent project, with no affiliation to Shelly or Allterco Robotics. It is neither commissioned, nor sponsored, nor endorsed by Shelly. No payment or hardware has been provided or lent by the brand. Shelly is a registered trademark of its respective owner; it is mentioned only for technical compatibility.</string>
    <string name="about_compat">Compatible with Shelly Gen2 and later. Support for other brands is planned for future versions.</string>
    <string name="about_license_title">License</string>
    <string name="about_license">Distributed under the GPLv3 license.</string>
    <string name="about_license_link">(learn more)</string>
    <string name="about_contact_title">Contact</string>
    <string name="about_contact_body">Questions, feedback, bug reports — you can also reach me here:</string>
