<!-- Icône Hestia — symbole marche/arrêt (IEC 60417) : anneau bleu ouvert (la barre craie masque
     le haut de l'anneau) + barre verticale bleue + voyant orange fixe. Converti de assets/. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Anneau (cercle plein, tracé) -->
    <path
        android:strokeColor="#1B3AAB"
        android:strokeWidth="7.2"
        android:fillColor="#00000000"
        android:pathData="M32.5,59 A21.5,21.5 0 1 0 75.5,59 A21.5,21.5 0 1 0 32.5,59" />

    <!-- Barre craie qui « ouvre » le haut de l'anneau -->
    <path
        android:fillColor="#F4F3EF"
        android:pathData="M49.8,31.7 A4.2,4.2 0 0 1 58.2,31.7 L58.2,50.8 A4.2,4.2 0 0 1 49.8,50.8 Z" />

    <!-- Barre verticale bleue -->
    <path
        android:fillColor="#1B3AAB"
        android:pathData="M50.3,32.9 A3.7,3.7 0 0 1 57.7,32.9 L57.7,49.5 A3.7,3.7 0 0 1 50.3,49.5 Z" />

    <!-- Voyant orange fixe (mise sous tension), décoratif -->
    <path
        android:fillColor="#E8622C"
        android:pathData="M68.8,35 A6.2,6.2 0 1 0 81.2,35 A6.2,6.2 0 1 0 68.8,35" />
